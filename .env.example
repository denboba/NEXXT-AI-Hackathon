# Server-only configuration. Never use VITE_ for secrets.
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# Supply AWS_BEARER_TOKEN_BEDROCK securely through your environment settings.
# npm scripts inherit the environment; this file is a reference, not automatically loaded.
# Optional: secret (16+ characters) for signing consent receipts. If unset, a random
# per-process secret is used and receipts become invalid after a restart.
# CONSENT_RECEIPT_SECRET=
